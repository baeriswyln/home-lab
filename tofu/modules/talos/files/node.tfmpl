machine:
  install:
    image: ${initial_image}
  network:
    nameservers:
      - ${nameserver1}
      - ${nameserver2}
      - 8.8.8.8

    interfaces:
    - deviceSelector:
        physical: true
      dhcp: false
      addresses:
        - ${ip_addr}
      routes:
        - gateway: ${gateway}

  kubelet:
    extraArgs:
      rotate-server-certificates: true
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: off
hostname: ${hostname}