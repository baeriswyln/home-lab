machine:
  network:
    interfaces:
    - deviceSelector:
        physical: true
      vip:
        ip: ${virtual_ip}

# required configuration for monitoring
cluster: 
  proxy:
    extraArgs:
      metrics-bind-address: 0.0.0.0
  controllerManager:
    extraArgs:
      bind-address: 0.0.0.0
        
  scheduler:
    extraArgs:
      bind-address: 0.0.0.0